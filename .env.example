RAG_ENVIRONMENT=development
RAG_TENANT_ID=portfolio
RAG_POSTGRES_HOST=127.0.0.1
RAG_POSTGRES_PORT=5545
RAG_POSTGRES_DATABASE=rag_portfolio
RAG_POSTGRES_USER=rag_portfolio
RAG_POSTGRES_PASSWORD=
RAG_QDRANT_URL=http://127.0.0.1:6534
RAG_QDRANT_API_KEY=
RAG_EMBEDDING_PROVIDER=alibaba_dashscope
RAG_EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/api/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_OUTPUT_TYPE=dense
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_SERVICE_TOKEN=
RAG_ADMIN_TOKEN=
RAG_AGENT_TOKEN=
RAG_AGENT_SCOPE_KEYS=["shared"]
RAG_AGENT_AUDIENCE=internal
RAG_READ_SCOPE_KEYS=["shared"]
# Public /v1/knowledge/search routing. Knowledge IDs and retrieval policy stay here.
RAG_KNOWLEDGE_GLOBAL_KB_IDS=[]
# Example: {"医院外部spaceId":{"help":["<kb-uuid>"],"product":["<kb-uuid>"]}}
RAG_KNOWLEDGE_SPACE_KB_IDS={}
RAG_KNOWLEDGE_STRATEGY=hybrid
RAG_KNOWLEDGE_CANDIDATE_K=40
RAG_KNOWLEDGE_TOP_K=5
RAG_KNOWLEDGE_MAX_CONTEXT_TOKENS=4000
RAG_WORKER_POLL_SECONDS=2
RAG_WORKER_LEASE_SECONDS=60
RAG_WORKER_MAX_ATTEMPTS=3
RAG_ASSET_ROOT=data
RAG_INGESTION_MAX_BYTES=67108864
RAG_INGESTION_CHUNK_SIZE=512
RAG_INGESTION_CHUNK_OVERLAP=64
RAG_DOCLING_OCR=false
RAG_DOCLING_TABLES=true
RAG_DOCLING_THREADS=2
# Optional predownloaded Docling artifacts directory. There is no parser fallback.
RAG_DOCLING_ARTIFACTS_PATH=
# Pinned Heron layout model commit; TableFormer uses Docling's v2.3.0 model revision.
RAG_DOCLING_MODEL_REVISION=8f39ad3c0b4c58e9c2d2c84a38465abf757272d8
RAG_RERANK_MODEL=qwen3.7-text-rerank
# OpenAI-compatible optional answer endpoint, including /v1; evidence mode needs none.
RAG_ANSWER_BASE_URL=
RAG_ANSWER_API_KEY=
RAG_ANSWER_MODEL=
# Isolated technical demo only. Defaults stay disabled; never enable in production.
RAG_DEMO_RETRIEVAL_ENABLED=false
RAG_DEMO_TOKEN=
RAG_DEMO_TENANT_ID=integration-demo
RAG_DEMO_SCOPE_KEY=integration-demo
RAG_DEMO_CORPUS_PATH=
RAG_DEMO_CORPUS_SHA256=
