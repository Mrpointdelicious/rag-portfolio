          "page": null
        }
      ]
    },
    {
      "code": "auth-guide",
      "title": "访问边界说明",
      "version": "v1",
      "domain": "help",
      "source": "repo://hybrid-demo/auth-guide",
      "license": "CC0-1.0",
      "approved_by": "task-author-technical-demo-2026-10-11",
      "approved": true,
      "text": "混合检索只允许hybrid-demo范围的operator访问，禁止患者身份与production模式。域和语料版本由可信服务配置限制，模型不得自行扩大权限。\n来源指纹、原文哈希或索引版本不匹配时拒绝检索。引用成员合法只说明来源存在，不保证解释由证据支持，也不保证临床正确。",
      "text_sha256": "4b1e0f61ff224e376418912d4cabffafbe260d1b60106238edf43321fc387566",
      "sections": [
        {
          "section_id": "authority",
          "title": "权限",
          "start": 0,
          "end": 79,
          "page": null
        },
        {
          "section_id": "integrity",
          "title": "完整性",
          "start": 80,
          "end": 137,
          "page": null
        }
      ]
    },
    {
      "code": "queue-guide",
      "title": "排队调节说明",
      "version": "v1",
      "domain": "help",
      "source": "repo://hybrid-demo/queue-guide",
      "license": "CC0-1.0",
      "approved_by": "task-author-technical-demo-2026-10-11",
      "approved": true,
      "text": "生产者速度持续超过消费者时，应让生产者暂缓投递，直到队列恢复空闲容量；该机制保护消费者，防止积压无限增长。演示没有给出具体吞吐量。",
      "text_sha256": "e3cc8f1476ea10652026350e81d8c8d320b5d86dfa95b17db0d512a8cad09f99",
      "sections": [
        {
          "section_id": "flow",
          "title": "过载调节",
          "start": 0,
          "end": 65,
          "page": null
        }
      ]
    },
    {
      "code": "context-guide",
      "title": "上下文打包说明",
      "version": "v1",
      "domain": "help",
      "source": "repo://hybrid-demo/context-guide",
      "license": "CC0-1.0",
      "approved_by": "task-author-technical-demo-2026-10-11",
      "approved": true,
      "text": "上下文打包按完整片段及其引用元数据计算预算，不能在句中剪掉否定词或数字；放不下则省略整个片段，设置budget_truncated，并提示证据不足。\nEvidence具有有效期。过期的工具结果应从当前模型上下文失效，再次追问应重新查询。旧回答保留并不代表旧证据仍可引用。",
      "text_sha256": "2addd7313ba33a6c45e12102f99bca11d86f900c327aacf13908919bb18ef96e",
      "sections": [
        {
          "section_id": "packing",
          "title": "预算打包",
          "start": 0,
          "end": 74,
          "page": null
        },
        {
          "section_id": "ttl",
          "title": "证据时效",
          "start": 75,
          "end": 135,
          "page": null
        }
      ]
    },
    {
      "code": "client-guide",
      "title": "客户端故障说明",
      "version": "v1",
      "domain": "help",
      "source": "repo://hybrid-demo/client-guide",
      "license": "CC0-1.0",
      "approved_by": "task-author-technical-demo-2026-10-11",
      "approved": true,
      "text": "Dense或BM25其中一路失败而另一路提供证据时为partial；重排失败可显式降级并标记rerank_applied=false。没有可用证据时为unavailable，响应被篡改或内部证据不一致时为failed。\n演示客户端单次最多调用一次Embedding和一次Reranker，不自动重试；限制请求时限、响应字节数和工具调用次数。预算不是模型收费token数。",
      "text_sha256": "6ee5c3583473d3a0fd458197e94a1be351acce86242fe8352613740427d4e958",
      "sections": [
        {
          "section_id": "errors",
          "title": "故障",
          "start": 0,
          "end": 109,
          "page": null
        },
        {
          "section_id": "budget",
          "title": "调用上限",
          "start": 110,
          "end": 185,
          "page": null
        }
      ]
    }
