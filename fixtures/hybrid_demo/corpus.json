  "documents": [
    {
      "code": "index-a",
      "title": "索引方案甲",
      "version": "v1",
      "domain": "help",
      "source": "repo://hybrid-demo/index-a",
      "license": "CC0-1.0",
      "approved_by": "task-author-technical-demo-2026-10-11",
      "approved": true,
      "text": "索引方案甲面向单机演示，保存静态文本片段，只读查询，不支持在线发布、删除或患者数据。\n索引方案甲在构建时批量生成文档向量；查询时实时生成问题向量，使用余弦相似度检索，再用BM25和RRF融合。\n索引方案甲计划评估完整证据覆盖率和查询延迟；尚未报告实测延迟，也没有证明答案准确率。",
      "text_sha256": "e7021a2c28aaa4c313e65481ec5a96e787604d3b55fae2bf24802165d8430889",
      "sections": [
        {
          "section_id": "population",
          "title": "使用范围",
          "start": 0,
          "end": 42,
          "page": null
        },
        {
          "section_id": "intervention",
          "title": "构建方法",
          "start": 43,
          "end": 96,
          "page": null
        },
        {
          "section_id": "outcomes",
          "title": "计划指标",
          "start": 97,
          "end": 139,
          "page": null
        }
      ]
    },
    {
      "code": "index-b",
      "title": "索引方案乙",
      "version": "v1",
      "domain": "help",
      "source": "repo://hybrid-demo/index-b",
      "license": "CC0-1.0",
      "approved_by": "task-author-technical-demo-2026-10-11",
      "approved": true,
      "text": "索引方案乙面向隔离容器演示，保存静态文本片段，只读查询，不支持正式环境发布或患者数据。\n索引方案乙使用独立向量集合；查询时实时生成问题向量，再与BM25排名做RRF融合，可调用远程重排模型。\n索引方案乙计划评估多来源证据覆盖率和上下文预算内完成率；尚未报告实测吞吐量，也没有证明答案准确率。",
      "text_sha256": "ad5a223adec5f479a3ec9ff6d196aae68a7882c7e846968d1f3e79ec08edd1ea",
      "sections": [
        {
          "section_id": "population",
          "title": "使用范围",
          "start": 0,
          "end": 43,
          "page": null
        },
        {
          "section_id": "intervention",
          "title": "构建方法",
          "start": 44,
          "end": 95,
          "page": null
        },
        {
          "section_id": "outcomes",
          "title": "计划指标",
          "start": 96,
          "end": 145,
          "page": null
        }
      ]
    },
    {
      "code": "retention-a",
      "title": "保留规范甲",
      "version": "v1",
      "domain": "help",
      "source": "repo://hybrid-demo/retention-a",
      "license": "CC0-1.0",
      "approved_by": "task-author-technical-demo-2026-10-11",
      "approved": true,
      "text": "保留规范甲规定：演示检索记录保留7天，随后删除；这是甲团队的技术建议，不是全公司的统一规则。",
      "text_sha256": "56b32343a2119d94cfe76d2baabc480e2bfc03ab0b004c37a3af32596421c7e5",
      "sections": [
        {
          "section_id": "retention",
          "title": "保留时限",
          "start": 0,
          "end": 46,
          "page": null
        }
      ]
    },
    {
      "code": "retention-b",
      "title": "保留规范乙",
      "version": "v1",
      "domain": "help",
      "source": "repo://hybrid-demo/retention-b",
      "license": "CC0-1.0",
      "approved_by": "task-author-technical-demo-2026-10-11",
      "approved": true,
      "text": "保留规范乙规定：演示检索记录保留30天，随后删除；这是乙团队的技术建议，与甲团队的7天建议存在冲突。两份建议没有给出统一优先级。",
      "text_sha256": "f67714f506fa316c14301e16fadd9a137ac0868d4e0047955382423520f41beb",
      "sections": [
        {
          "section_id": "retention",
